# Copie este arquivo para ".env" e preencha com sua própria chave.
# NUNCA coloque a chave direto no código, e nunca suba o ".env" para o Git.

# Obtida em https://api.portaldatransparencia.gov.br/api-de-dados (login gov.br,
# nível Prata/Ouro ou CPF+senha com 2º fator). Chave enviada por e-mail.
# Usada pelo módulo verificacao/ para consultar CEIS e CNEP.
PORTAL_TRANSPARENCIA_API_KEY=
