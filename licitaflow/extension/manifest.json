{
  "manifest_version": 3,
  "name": "LicitaFlow",
  "version": "0.1.0",
  "description": "Acompanha a homologação item a item dos pregões no Compras.gov.br e avisa quando a ata pode ser liberada.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.gov.br/compras/*",
    "https://cnetmobile.estaleiro.serpro.gov.br/*",
    "https://contratos.comprasnet.gov.br/*",
    "https://www.comprasnet.gov.br/*",
    "ws://localhost/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gov.br/compras/*",
        "https://cnetmobile.estaleiro.serpro.gov.br/*",
        "https://contratos.comprasnet.gov.br/*",
        "https://www.comprasnet.gov.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LicitaFlow — abrir painel lateral",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}